# Local tools (portable gh etc.) — kept in the project folder, never committed
.tools/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Caches, temp, logs, build output (regeneratable; see master prompt §18)
cache/
.cache/
tmp/
build/
dist/
*.log

# Model weights are distributed separately with checksums (§23, §24); never committed
models/weights/
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.engine
*.cat

# Local hardware telemetry (machine-specific)
logs/

# Probe render output (regeneratable from the probe scripts)
research/**/out/

# Nuke autosaves and backups
*.nk~
*.autosave
*.nk.autosave*

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Regeneratable synthetic footage and large reference arrays
research/**/frames/
research/**/*.npz

# Derived model artefacts (exports, constants extracted from weights): never committed (D-008)
models/onnx/

# Nuke integration test output
tests/nuke/out/
tests/nuke/out_*.txt

# Model verification stamps (machine-specific, st_roto_ai.registry)
models/.verified.json
*.catnc
research/probes/2026-11-16_route_a/out/
research/probes/2026-11-16_route_a/reference.npz

# Benchmark / calibration data (D-031: licensed datasets, never committed)
data/

# private signing keys (T-084): never committed
*.strotokey
